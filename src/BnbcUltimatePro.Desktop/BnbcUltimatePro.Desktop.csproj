<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>BnbcUltimatePro</AssemblyName>
    <RootNamespace>BnbcUltimatePro.Desktop</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>BNBC Engineering Solutions</Authors>
    <Product>BNBC ULTIMATE PRO</Product>
    <Description>BNBC 2020 (All 64 Districts) &amp; ETABS 22 Structural Automation Suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BnbcUltimatePro.Core\BnbcUltimatePro.Core.csproj" />
    <ProjectReference Include="..\BnbcUltimatePro.EtabsIntegration\BnbcUltimatePro.EtabsIntegration.csproj" />
  </ItemGroup>
</Project>
